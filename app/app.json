{
  "expo": {
    "name": "지구여행",
    "slug": "earth-travel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.earthtravel.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "여행 기록에 사진을 첨부하기 위해 사진 보관함에 접근합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.earthtravel.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 기록에 사진을 첨부하기 위해 사진 보관함에 접근합니다."
        }
      ]
    ],
    "scheme": "earthtravel",
    "backgroundColor": "#0b1020",
    "experiments": {
      "typedRoutes": false
    }
  }
}
