# PostgreSQL 연결 문자열
DATABASE_URL=postgres://earth:earth@localhost:5432/earth_travel
# JWT 서명 키 (운영에서는 반드시 긴 랜덤 문자열로 교체)
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# 외부에서 접근 가능한 서버 주소 (업로드한 사진 URL 생성에 사용)
PUBLIC_BASE_URL=http://localhost:4000

# 사진 저장소: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# STORAGE_DRIVER=s3 일 때 (AWS S3, Cloudflare R2, MinIO 등 S3 호환 스토리지)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 버킷의 공개 URL (예: https://cdn.example.com)
S3_PUBLIC_URL=
